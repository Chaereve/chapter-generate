{
  "name": "chuseoz-story-editor",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "description": "Chuseoz — bộ soạn truyện chat cho Blogger. Một file HTML, không phụ thuộc runtime.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tabler/icons": "^3.48.0",
    "eslint": "^9.18.0",
    "happy-dom": "^16.5.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^3.0.4"
  }
}
